# ===== 数据库配置 =====
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ai_tutor
DB_USERNAME=root
DB_PASSWORD=root

# ===== Redis 配置 =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ===== 服务端口 =====
APP_PORT=8088

# ===== AI 大模型配置（DeepSeek 兼容 OpenAI 协议，Key 占位，请自行填入） =====
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=sk-your-deepseek-api-key-here
AI_MODEL=deepseek-chat
AI_VISION_MODEL=deepseek-vl

# ===== 默认教师账号 =====
TEACHER_USERNAME=teacher
TEACHER_PASSWORD=teacher123

# ===== 上传与预览 =====
UPLOAD_DIR=./uploads
# LibreOffice 可执行文件路径（PPT 预览优先用它转 PDF，服务器需安装 libreoffice-impress）
SOFFICE_PATH=soffice
# 预览渲染 DPI
PREVIEW_DPI=120
